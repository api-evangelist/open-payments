          "name": "Query a dataset distribution (GET)",
          "request": {
            "name": "Query a dataset distribution (GET)",
            "description": {
              "content": "Query the rows of a dataset's distribution by dataset id and distribution index (usually 0). Filtering, column selection, sorting, and pagination are expressed as query-string parameters. No authentication required.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "datastore",
                "query",
                ":datasetId",
                ":index"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "500",
                  "description": "Maximum number of rows to return."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of rows to skip for pagination."
                },
                {
                  "disabled": false,
                  "key": "conditions",
                  "value": "<string>",
                  "description": "Filter conditions (property, value, operator)."
                },
                {
                  "disabled": false,
                  "key": "properties",
                  "value": "<string>",
                  "description": "Subset of columns to return."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "datasetId",
                  "description": "(Required) The dataset UUID."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "0",
                  "key": "index",
                  "description": "(Required) The zero-based distribution index within the dataset."
                }
